{
  "version": 2,
  "builds": [
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    },
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/favicon.ico",
      "dest": "/api/index.js"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/frontend/assets/$1"
    },
    {
      "src": "/css/(.*)",
      "dest": "/frontend/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/frontend/js/$1"
    },
    {
      "src": "/",
      "dest": "/frontend/index.html"
    },
    {
      "src": "/index.html",
      "dest": "/frontend/index.html"
    },
    {
      "src": "/main.html",
      "dest": "/frontend/main.html"
    },
    {
      "src": "/separator.html",
      "dest": "/frontend/separator.html"
    },
    {
      "src": "/user_key_data.html",
      "dest": "/frontend/user_key_data.html"
    },
    {
      "src": "/love.html",
      "dest": "/frontend/love.html"
    },
    {
      "src": "/number.html",
      "dest": "/frontend/number.html"
    },
    {
      "src": "/color.html",
      "dest": "/frontend/color.html"
    },
    {
      "src": "/hora.html",
      "dest": "/frontend/hora.html"
    },
    {
      "src": "/tarot.html",
      "dest": "/frontend/tarot.html"
    }
  ]
}
